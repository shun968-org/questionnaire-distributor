{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:memory": "tsx watch src/dev-memory.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import-pro-ctcae": "tsx scripts/import-pro-ctcae.ts",
    "pro-ctcae:export": "tsx scripts/export-pro-ctcae.ts",
    "start:memory": "tsx src/dev-memory.ts",
    "build:trial": "esbuild src/dev-memory.ts --bundle --platform=node --format=esm --target=node22 --external:pdfjs-dist --outfile=dist/trial.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
